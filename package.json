{
  "name": "@bloxmind-studio/desktop",
  "private": true,
  "version": "0.99.9",
  "description": "AI-assisted Roblox development from a secure desktop app",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "license": "MIT",
  "author": {
    "name": "YUouriii",
    "email": "aiden00iu@gmail.com"
  },
  "homepage": "https://bloxmindai.netlify.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/BloxMind-studio/bloxmind-desktop.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc && vite build",
    "package": "node scripts/ensure-env.mjs && pnpm build && electron-builder",
    "preview": "vite preview",
    "lint": "biome check src/ electron/ scripts/",
    "lint:fix": "biome check --write src/ electron/ scripts/",
    "test": "vitest run && pnpm test:release",
    "test:unit": "vitest run",
    "test:release": "node --test scripts/*.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lexical/react": "^0.48.0",
    "@lexical/utils": "^0.48.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opencode-ai/sdk": "^1.18.18",
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tanstack/react-query": "^5.91.2",
    "@tanstack/react-virtual": "^3.13.23",
    "effect": "^3.22.0",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "isomorphic-git": "^1.41.9",
    "lexical": "^0.48.0",
    "lucide-react": "^1.31.0",
    "posthog-js": "^1.363.1",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "sucrase": "3.35.0",
    "systeminformation": "^5.31.16",
    "tar": "^7.5.20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.0.1",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^4.1.10"
  }
}
