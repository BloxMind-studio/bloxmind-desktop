{
  "name": "bloxmind",
  "private": true,
  "version": "0.16.0",
  "description": "AI-assisted Roblox development from a secure desktop app",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.19.0"
  },
  "author": {
    "name": "YUouriii",
    "email": "aiden00iu@gmail.com"
  },
  "homepage": "https://BloxMind.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/BloxMind-studio/bloxmind-desktop.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc && vite build",
    "package": "pnpm build && electron-builder",
    "preview": "vite preview",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "test": "vitest run && pnpm test:release",
    "test:release": "node --test scripts/*.test.ts",
    "test:watch": "vitest",
    "check:opencode-pin": "cross-env OPENCODE_PIN_CHECK=1 vitest run src/test/opencodePinnedRelease.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit && tsc -p scripts/bloxmind-programs/tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "bloxmind-programs": "jiti scripts/bloxmind-programs/cli.ts"
  },
  "dependencies": {
    "@lexical/react": "^0.48.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opencode-ai/sdk": "^1.19.5",
    "@opencode/client": "2.2.6",
    "@shikijs/core": "^4.6.0",
    "@shikijs/engine-javascript": "^4.6.0",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "effect": "^3.22.4",
    "electron-updater": "^6.8.11",
    "extract-zip": "^2.0.1",
    "lexical": "^0.48.0",
    "lucide-react": "^1.70.0",
    "posthog-js": "^1.447.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "sucrase": "3.35.1",
    "systeminformation": "^5.33.19",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "^10.1.0",
    "electron": "^44.10.2",
    "electron-builder": "^26.18.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-electron": "^1.2.0",
    "vitest": "^5.1.0"
  }
}
