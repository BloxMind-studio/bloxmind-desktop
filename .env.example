VITE_POSTHOG_PROJECT_TOKEN=phc_replace_with_your_project_token
NEXT_PUBLIC_CORE_API_URL=
NEXT_PUBLIC_BLOXMIND_API_TOKEN=
# Roblox OAuth app client id — required to ENFORCE the license gate in packaged
# builds. If left empty (dev / test packaging), the app launches in bypass mode.
ROBLOX_CLIENT_ID=
# License server base URL (defaults to the hosted BloxMind Core Engine).
BLOXMIND_LICENSE_API_URL=
