const fs = require('fs');
const path = require('path');

const filePath = path.join(process.cwd(), 'src/components/ContextUsageIndicator.tsx');
let content = fs.readFileSync(filePath, 'utf8');

// Replace the token calculation block
const oldBlock = `    // Accumulate tokens across ALL assistant messages to reflect the true
    // continuous context window state.
    //
    // Formula (per the user's spec):
    //   Total Context Usage = cached_prompt_tokens + uncached_prompt_tokens + completion_tokens
    //
    // In the SDK token shape:
    //   - input       = uncached_prompt_tokens (prompt tokens NOT served from cache)
    //   - cache.read  = cached_prompt_tokens   (prompt tokens served from cache)
    //   - output      = completion_tokens      (tokens generated by the model)
    //
    // So per message: total = input + cache.read + output
    //
    // Previously, the code only took the latest message's \`input\` tokens and
    // broke immediately, which reset the counter on every new message.
    let total = 0;
    for (let i = messagesCache.messageIds.length - 1; i >= 0; i--) {
      const msg = messagesCache.messagesById[messagesCache.messageIds[i]];
      if (!msg) continue;

      // Only count assistant messages — user messages don't carry token info.
      if (msg.info.role !== "assistant") continue;

      // The SDK Message type has a \`tokens\` field with input/output/cache.
      // We cast to access the full shape since the SDK type may be partial.
      const tokens = msg.info.tokens as {
        input?: number;
        output?: number;
        cache?: { read?: number; write?: number };
        total?: number;
      } | undefined;

      if (!tokens) continue;

      // Formula: uncached_prompt + cached_prompt + completion
      const input = tokens.input ?? 0;
      const cacheRead = tokens.cache?.read ?? 0;
      const output = tokens.output ?? 0;

      total += input + cacheRead + output;
    }`;

const newBlock = `    // Calculate the total active context window size.
    //
    // Formula:
    //   Total Active Context = (Latest cached_tokens) + (accumulated uncached_input_tokens) + (accumulated output_tokens)
    //
    // Key rules:
    //   1. cached_tokens (cache.read) is a STATE SNAPSHOT, not an additive metric.
    //      It already represents the total cached prompt size up to the current turn.
    //      We take the LATEST value only — do NOT sum across turns (that would double-count).
    //   2. uncached_input_tokens (input) and output_tokens (output) ARE additive —
    //      they represent incremental activity per turn, so we sum them across all messages.
    //
    // In the SDK token shape:
    //   - input       = uncached_prompt_tokens (prompt tokens NOT served from cache)
    //   - cache.read  = cached_prompt_tokens   (prompt tokens served from cache — SNAPSHOT)
    //   - output      = completion_tokens      (tokens generated by the model)
    let totalInput = 0; // Sum of uncached input tokens across all turns
    let totalOutput = 0; // Sum of output tokens across all turns
    let latestCacheRead = 0; // Latest cache.read snapshot (replaced, not summed)

    for (let i = messagesCache.messageIds.length - 1; i >= 0; i--) {
      const msg = messagesCache.messagesById[messagesCache.messageIds[i]];
      if (!msg) continue;

      // Only count assistant messages — user messages don't carry token info.
      if (msg.info.role !== "assistant") continue;

      // The SDK Message type has a \`tokens\` field with input/output/cache.
      // We cast to access the full shape since the SDK type may be partial.
      const tokens = msg.info.tokens as {
        input?: number;
        output?: number;
        cache?: { read?: number; write?: number };
        total?: number;
      } | undefined;

      if (!tokens) continue;

      // Accumulate additive metrics (input + output).
      totalInput += tokens.input ?? 0;
      totalOutput += tokens.output ?? 0;

      // cache.read is a snapshot — take the latest value (first encountered
      // in reverse iteration = newest message with token data).
      if (latestCacheRead === 0 && (tokens.cache?.read ?? 0) > 0) {
        latestCacheRead = tokens.cache?.read ?? 0;
      }
    }

    // Total Active Context = latest cached snapshot + accumulated uncached input + accumulated output
    const total = latestCacheRead + totalInput + totalOutput;`;

if (content.includes('total += input + cacheRead + output;')) {
  // Use regex to match across CRLF
  const regex = /    \/\/ Accumulate tokens across ALL assistant messages[\s\S]*?    total \+= input \+ cacheRead \+ output;\n    \}/;
  content = content.replace(regex, newBlock);
  console.log('Replaced token calculation block');
} else {
  console.log('Pattern not found - checking content...');
  console.log('Has totalInput:', content.includes('totalInput'));
  console.log('Has latestCacheRead:', content.includes('latestCacheRead'));
}

fs.writeFileSync(filePath, content, 'utf8');
console.log('Done');